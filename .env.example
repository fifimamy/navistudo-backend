# NaviStudo Backend Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to Git - it is already in .gitignore.

# ============================================================
# Flask Configuration
# ============================================================
FLASK_ENV=development
SECRET_KEY=change-me-to-a-random-string

# ============================================================
# Firebase Configuration (REQUIRED)
# ============================================================
# Option 1: Individual environment variables
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
# Private key with literal \n newlines (not actual newlines)
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQIBADANBgkqhkiG9w0BAQEFAASCBKcwggSjAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# Option 2: Path to service account JSON file (alternative to above)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json

# Firestore collection names (optional - defaults shown)
# FIRESTORE_STUDENTS_COLLECTION=students
# FIRESTORE_KB_COLLECTION=knowledge_base
# FIRESTORE_RESULTS_COLLECTION=recommendation_results

# ============================================================
# AI Provider Configuration (REQUIRED for real AI calls)
# ============================================================
# OpenAI API key for Model 1 and Model 2
OPENAI_API_KEY=sk-your-key-here

# Custom API base URL (optional - for compatible providers)
# OPENAI_API_BASE=https://api.openai.com/v1

# Model names (optional - defaults shown)
AI_MODEL_ONE_NAME=gpt-4o-mini
AI_MODEL_TWO_NAME=gpt-4o-mini

# AI Provider Settings (optional - defaults shown)
AI_MODEL_ONE_TEMPERATURE=0.0
AI_MODEL_TWO_TEMPERATURE=0.0
AI_MODEL_ONE_TIMEOUT=30
AI_MODEL_TWO_TIMEOUT=30
AI_MODEL_ONE_MAX_RETRIES=2
AI_MODEL_TWO_MAX_RETRIES=2

# ============================================================
# CORS Configuration
# ============================================================
# Comma-separated list of allowed frontend origins
# Use "*" for development only - replace with specific origins in production
CORS_ORIGINS=http://localhost:3000

# ============================================================
# Knowledge Base
# ============================================================
# Path to knowledge base JSON files directory
# KNOWLEDGE_BASE_DIR=data/knowledge_base
